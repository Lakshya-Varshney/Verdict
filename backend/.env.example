# DOGFOOD API Configuration

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/dogfood
DATABASE_ECHO=false

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting (optional Redis)
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_VOTES_PER_MINUTE=5
RATE_LIMIT_COMMENTS_PER_MINUTE=10

# Seed data on startup
SEED_ON_STARTUP=true

# Application
APP_NAME=DOGFOOD API
APP_VERSION=1.0.0
DEBUG=false
