# --- Frontend runtime config ---
# true  = built-in mock API (works with zero backend, great for demos + design review)
# false = talk to the real FastAPI backend through the /api proxy
NEXT_PUBLIC_MOCK=true

# Browser-side base URL. Keep "/api" so requests are same-origin (proxied by next.config.mjs).
NEXT_PUBLIC_API_URL=/api

# Server-side (Next.js -> FastAPI) target. In docker compose this is the service name.
API_INTERNAL_URL=http://backend:8000
